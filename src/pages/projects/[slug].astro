---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
import { getProjectAreaLabel } from "../../components/project/projectLabels";
import ProjectMetaRail from "../../components/project/ProjectMetaRail.astro";
import ProjectMasthead from "../../components/project/ProjectMasthead.astro";
import ProjectCaseStudySections from "../../components/project/ProjectCaseStudySections.astro";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const areaLabel = getProjectAreaLabel(project.area);
---

<BaseLayout title={project.title} description={project.summary}>
  <main class="mx-auto max-w-7xl px-6 py-10 md:px-10 md:py-16">
    <a href={`/${project.area}`} class="text-sm font-semibold hover:underline">
      ← Back to {areaLabel}
    </a>

    <section class="mt-8 border-t border-neutral-950 pt-8 md:pt-12">
      <div class="grid gap-10 lg:grid-cols-[0.32fr_1fr]">
        <ProjectMetaRail project={project} />

        <div class="order-1 lg:order-2">
          <ProjectMasthead project={project} />
          <ProjectCaseStudySections project={project} />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>