---
import PageIntro from "../components/PageIntro.astro";
import ProjectList from "../components/ProjectList.astro";
import { projects } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";

const developmentProjects = projects.filter(
  project => project.area === 'development' && project.featured
);
---

<BaseLayout title="Web Developer">
  <main class="mx-auto max-w-7xl px-6 py-16 md:px-10">
    <a href='/' class="text-sm font-semibold hover:underline">
      ← Back to home
    </a>

    <PageIntro
      eyebrow="01 / Web Development"
      title="Web applications for structured information."
      description="I build React applications, CMS-backed websites, static sites, and search interfaces for projects with detailed content and complex relationships."
    />

    <ProjectList
      projects={developmentProjects}
      heading="Selected development projects"
      description="Research databases, CMS projects, static sites, and tools for browsing structured content."
    />
  </main>
</BaseLayout>