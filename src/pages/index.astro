---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Alexis Millares Thomson">
  <main>
    <section class="mx-auto max-w-7xl px-6 py-10 md:px-10 md:py-14">
      <section class="grid min-h-[calc(100vh-120px)] items-center gap-12 md:grid-cols-[1.15fr_0.85fr]">
        <div>
          <p class="mb-6 max-w-xl text-sm uppercase tracking-[0.22em] text-neutral-700">
            Web developer · Music Theorist
          </p>

          <h1 class="max-w-4xl font-(--font-serif) text-3xl leading-[1.03] tracking-[-0.035em] text-neutral-950 sm:text-5xl md:text-[3rem] lg:text-[3rem]">
            I build clear digital tools for complex information.
          </h1>

          <div class="mt-8 max-w-2xl space-y-5 text-lg leading-8 text-neutral-800">
            <p>
              I'm a full-stack web developer with a background in music theory, research, and teaching. I work on React applications, CMS-backed websites, research databases, and interfaces for browsing complex content.
            </p>

            <p>
              I'm especially interested in projects where the material is detailed, relational, or challenging to organize: archives, catalogues, research databases, educational tools, and editorial workflows.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold">
            <a href="/development" class="text-(--color-accent) hover:underline">
              Development work →
            </a>

            <a href="/music-theory" class="text-(--color-accent) hover:underline">
              Music-theory work →
            </a>

            <a href="/cv.pdf" class="hover:underline">
              View CV →
            </a>
          </div>
        </div>

        <div class="md:justify-self-end">
          <div class="max-w-sm">
            <img
              src="/assets/profile.jpg"
              alt="Alexis Millares Thomson"
              class="w-full rounded-sm border border-neutral-950"
            />

            <p class="mt-4 border-l-4 border-(--color-accent) pl-4 text-sm leading-6 text-neutral-700">
              PhD in Music Theory. Professional diploma in web development. Based in Toronto.
            </p>
          </div>
        </div>
      </section>

      <section class="mt-10 grid gap-5 border-t border-neutral-300 pt-8 md:grid-cols-2">
        <a
          href="/development"
          class="group rounded-sm bg-(--color-accent-dark) p-7 text-white transition hover:-translate-y-0.5 md:p-8"
        >
          <p class="mb-4 text-sm uppercase tracking-[0.22em] text-white/65">
            Development
          </p>

          <h2 class="max-w-xl text-3xl font-(--font-serif) leading-tight tracking-tight">
            Web applications, content systems, and searchable interfaces.
          </h2>

          <p class="mt-5 max-w-xl leading-7 text-white/78">
            React, JavaScript, TypeScript, Tailwind, Contentful, Netlify, and
            custom data workflows for projects that need more than a static site.
          </p>

          <p class="mt-7 text-sm font-semibold group-hover:underline">
            View development work →
          </p>
        </a>

        <a
          href="/music-theory"
          class="group rounded-sm border border-neutral-300 bg-neutral-50 p-7 transition hover:-translate-y-0.5 md:p-8"
        >
          <p class="mb-4 text-sm uppercase tracking-[0.22em] text-neutral-500">
            Music Theory
          </p>

          <h2 class="max-w-xl text-3xl font-(--font-serif) leading-tight tracking-tight text-neutral-950">
            Research, teaching, and interactive music-theory tools.
          </h2>

          <p class="mt-5 max-w-xl leading-7 text-neutral-700">
            My academic work focuses on musical structure, tuning systems, and
            analysis. Some of that work has become interactive software.
          </p>

          <p class="mt-7 text-sm font-semibold text-(--color-accent) group-hover:underline">
            View music-theory work →
          </p>
        </a>
      </section>
    </section>
  </main>
</BaseLayout>