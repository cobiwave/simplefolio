---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from '../components/layout/Footer.astro';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Alexis Millares Thomson",
  description = "Full-stack web developer and music theorist working across structured data, research, interface design, and music theory.",
} = Astro.props;

const pageTitle =
  title === "Alexis Millares Thomson"
    ? title
    : `${title} — Alexis Millares Thomson`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>

  <body class="bg-neutral-50 text-neutral-950 antialiased">
    <div class="min-h-screen">
      <Header />

      <slot />

      <Footer />
    </div>
  </body>
</html>