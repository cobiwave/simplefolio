---
import type { Project } from '../../data/projects';
import { getProjectAreaLabel } from './projectLabels';

type Props = {
  project: Project;
};

const { project } = Astro.props;
const areaLabel = getProjectAreaLabel(project.area);
---

<header>
  <p class="mb-5 text-sm uppercase tracking-[0.22em] text-neutral-600">
    {areaLabel} / Project
  </p>
  
  <h1 class="max-w-5xl text-5xl font-semibold tracking-[-0.055em] md:text-5xl">
    {project.title}
  </h1>
  
  <p class="mt-8 max-w-3xl text-2xl leading-9 text-neutral-800">
    {project.summary}
  </p>
  
  {
  project.image && (
    <figure class="mt-10 border border-neutral-950 bg-neutral-50 p-2">
      <div class="bg-white">
        <img
          src={project.image}
          alt=""
          loading="lazy"
          class="block w-full"
        />
      </div>
    </figure>
    )
  }
</header>