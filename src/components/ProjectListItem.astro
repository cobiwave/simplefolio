---
import type { Project } from "../data/projects";
import { getProjectAreaLabel, kindLabels, statusLabels } from "./project/projectLabels";

type Props = {
  project: Project;
};

const { project } = Astro.props;
---

<article class="grid gap-5 py-8 md:grid-cols-[8rem_1fr] lg:grid-cols-[9rem_1fr]">
  <aside class="text-sm leading-6 text-neutral-500">
    <p class="font-medium text-neutral-700">{project.year}</p>

    <p class="mt-2 uppercase tracking-[0.16em] text-neutral-500">
      {statusLabels[project.status]}
    </p>

    <p class="mt-2 text-neutral-500">
      {kindLabels[project.kind]}
    </p>
  </aside>
  
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_24rem] xl:grid-cols-[minmax(0,1fr)_28rem]">
    <div>
      <h3 class="max-w-3xl font-(--font-serif) text-3xl leading-tight tracking-[-0.02em] text-neutral-950">
        <a href={`/${project.area}/${project.slug}`} class="hover:text-(--color-accent) decoration-2 underline-offset-4 hover:underline">
          {project.title}
        </a>
      </h3>

      <p class="mt-3 max-w-3xl text-lg leading-8 text-neutral-800">
        {project.summary}
      </p>

      <p class="mt-2 max-w-3xl leading-7 text-neutral-700">
        {project.description}
      </p>

      <div class="mt-5">
        <a
          href={`/${project.area}/${project.slug}`}
          class="inline-flex items-center text-sm font-(--font-serif) text-(--color-accent) hover:underline"
        >
          View project details →
        </a>
      </div>

      <ul class="mt-5 flex flex-wrap gap-2">
        {
          project.tags.map((tag) => (
            <li class="rounded-full border border-neutral-300 bg-stone-100 px-3 py-1 text-xs uppercase tracking-[0.14em] text-neutral-600">
              {tag}
            </li>
          ))
        }
      </ul>

      {
        project.links && project.links.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm font-(--font-serif)">
            {project.links.map((link) => (
              <a href={link.href} class="text-(--color-accent) hover:underline">
                {link.label} →
              </a>
            ))}
          </div>
        )
      }
    </div>

    {
      project.image && (
        <img
          src={project.image}
          alt=""
          loading="lazy"
          class="block w-full rounded-sm border border-neutral-200"
        />
      )
    }
  </div>
</article>